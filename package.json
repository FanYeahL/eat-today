{
  "name": "eat-today",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:lan": "next dev -H 0.0.0.0",
    "dev:lan:https": "next dev -H 0.0.0.0 --experimental-https",
    "build": "next build",
    "start": "next start",
    "serve:lan": "next build && node scripts/serve-lan.mjs",
    "cert:lan": "node scripts/ensure-cert.mjs",
    "lint": "next lint",
    "test": "vitest",
    "test:run": "vitest run",
    "lint:data": "node scripts/lint-foods-fulldb.mjs",
    "lint:mojibake": "node scripts/lint-source-mojibake.mjs",
    "font:brand": "node scripts/gen-brand-font-subset.mjs",
    "typecheck": "tsc --noEmit",
    "audit:ci": "node scripts/audit-ci.mjs",
    "verify": "npm run lint:mojibake && npm run lint:data && npm run test:run && npm run typecheck && npm run lint"
  },
  "dependencies": {
    "framer-motion": "^12.40.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
